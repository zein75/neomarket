# Server-only BFF origin. Never expose internal URLs via NEXT_PUBLIC_*.
NEOMARKET_B2C_URL=http://b2c:8000
NEOMARKET_B2B_URL=http://b2b:8000
NEOMARKET_SELLER_ORIGIN=https://seller.example-market.test
# Generate a unique random value for every environment; keep it server-only.
NEOMARKET_CSRF_SECRET=replace-with-a-unique-random-secret
NEOMARKET_SESSION_SERVICE_URL=http://session:8080
NEOMARKET_PUBLIC_ORIGIN=https://www.example-market.test
# Keep false until the BFF DTO contract and integration tests are green.
NEXT_PUBLIC_ENABLE_LIVE_CATALOG=false
