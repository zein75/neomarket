{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.neomarket.example.invalid/event-envelope-v1.schema.json",
  "title": "NeoMarket Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "producer",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "occurred_at",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{2,99}$"
    },
    "producer": {
      "enum": [
        "b2b",
        "b2c",
        "admin"
      ]
    },
    "aggregate_type": {
      "enum": [
        "product",
        "inventory_order",
        "order",
        "moderation_ticket"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "payload": {
      "type": "object"
    }
  }
}
