# Copy to /etc/neomarket/staging.env as root and replace every <...> value.
# This file is a checklist only; it contains no usable credentials.
POSTGRES_PASSWORD=<generated>
ADMIN_POSTGRES_PASSWORD=<generated>
ADMIN_RUNTIME_DB_PASSWORD=<generated>
REDIS_PASSWORD=<generated>
B2B_SECRET_KEY=<generated>
B2C_SECRET_KEY=<generated>
ADMIN_SECRET_KEY=<generated>
SERVICE_KEY=<generated>
B2B_SERVICE_PRIVATE_KEY=<generated PEM>
B2C_SERVICE_PRIVATE_KEY=<generated PEM>
ADMIN_SERVICE_PRIVATE_KEY=<generated PEM>
TRUSTED_SERVICE_PUBLIC_KEYS=<generated JSON>

# Approved staging HTTPS and OIDC values; do not use HTTP or dev auth.
ADMIN_PUBLIC_ORIGIN=https://admin.neomarket.test
STOREFRONT_PUBLIC_ORIGIN=https://storefront.neomarket.test
SELLER_PUBLIC_ORIGIN=https://seller.neomarket.test
ADMIN_OIDC_ISSUER=https://keycloak.neomarket.test/realms/neomarket-staging
ADMIN_OIDC_JWKS_URL=https://keycloak.neomarket.test/realms/neomarket-staging/protocol/openid-connect/certs
# Private Docker service used only for server-side discovery/token/JWKS fetches.
# The issuer and browser redirect remain the public HTTPS values above.
ADMIN_OIDC_INTERNAL_BASE_URL=http://keycloak:8080
OIDC_INTERNAL_BASE_URL=http://keycloak:8080
ADMIN_OIDC_AUDIENCE=neomarket-admin
ADMIN_OIDC_CLIENT_ID=neomarket-admin-bff
ADMIN_OIDC_CLIENT_SECRET=<generated-by-keycloak>
ADMIN_OIDC_REQUIRED_AMR=otp
ADMIN_OIDC_STEP_UP_REQUIRED_AMR=otp

# Approved non-production SMTP sandbox and HTTPS media origin.
SELLER_EMAIL_SMTP_HOST=mailpit
SELLER_EMAIL_SMTP_PORT=587
SELLER_EMAIL_SMTP_USERNAME=neomarket-staging
SELLER_EMAIL_SMTP_PASSWORD=<generated-by-mailpit>
SELLER_EMAIL_SMTP_MODE=starttls
SELLER_EMAIL_FROM_ADDRESS=<staging-from-address>
SELLER_VERIFICATION_URL=https://seller.neomarket.test/verify-email
SELLER_INVITATION_URL=https://seller.neomarket.test/team/accept-invite
MEDIA_UPLOAD_SIGNING_SECRET=<generated>
MEDIA_PUBLIC_BASE_URL=https://seller.neomarket.test/api/v1/media/public
